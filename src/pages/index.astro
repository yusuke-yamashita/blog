---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import IconRss from "@/assets/icons/IconRss.svg";
import { Image } from "astro:assets";
import gomaImg from "@/assets/goma.png";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      {/* メインのコンテナ */}
      <div
        class="flex flex-col-reverse justify-between gap-6 sm:flex-row sm:items-center sm:gap-12"
      >
        {/* ▼ 左側のテキストエリア：要素を上から順に配置 */}
        <div class="flex flex-1 flex-col items-start gap-4">
          {/* 1. タイトル & 肩書き */}
          <div>
            <h1
              class="text-skin-accent mb-2 text-3xl font-bold tracking-tight whitespace-nowrap sm:text-5xl"
            >
              I am Yamazun.
            </h1>
            <p class="text-skin-base text-lg font-medium">
              <strong>System Fixer</strong> / バキバキQA / Dirty Tester / Philosopher
            </p>
          </div>

          {/* 2. 自己紹介文 */}
          <p class="text-skin-base max-w-lg leading-relaxed opacity-90">
            ソフトウェアテストをルーツに持ちつつ、System Fixerを目指しています。<br
            />
            ソフトウェアだけでなく、組織構造や人間関係の不具合もFixします。<br
            />
            私については Profile と Me にまとめています。
            {/* ▼▼▼ 追加: イラストレータークレジット ▼▼▼ */}
            <span class="mt-2 block text-sm opacity-80">
              (Illustrations by
              <a
                href="https://note.com/ranchero_58"
                target="_blank"
                class="hover:text-skin-accent underline decoration-dashed"
              >
                タスマニアデビ男
              </a>)
            </span>
            {/* ▲▲▲ 追加ここまで ▲▲▲ */}
          </p>

          {/* 3. ボタンエリア（ここに移動しました） */}
          <div class="py-2">
            <LinkButton href="/me"> Read "Me" </LinkButton>
          </div>

          {/* 4. ソーシャルリンク（一番下に配置） */}
          {
            SOCIALS.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <span class="me-2 whitespace-nowrap">Social Links:</span>
                <Socials />
              </div>
            )
          }
        </div>

        {/* ▼ 画像エリア */}
        <div class="mb-4 flex flex-shrink-0 flex-col items-center sm:mb-0">
          <Image
            src={gomaImg}
            class="border-skin-card h-32 w-32 rounded-full border-4 object-cover shadow-xl sm:h-48 sm:w-48"
            alt="守り神のごま"
          />
          <span
            class="text-skin-base mt-3 text-sm font-bold tracking-wider opacity-70"
          >
            守り神のごま
          </span>
        </div>
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <div class="mb-2 flex items-center gap-2">
            <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
            <a
              href="/rss.xml"
              target="_blank"
              aria-label="rss feed"
              title="RSS Feed"
              class="group inline-block"
            >
              <IconRss class="group-hover:fill-skin-accent h-6 w-6 scale-90 opacity-50 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100" />
            </a>
          </div>

          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
