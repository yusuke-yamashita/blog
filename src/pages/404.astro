---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import { Image } from "astro:assets";
import gomaImg from "@/assets/goma.png";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-3xl flex-1 items-center justify-center"
  >
    <div
      class="mb-14 flex flex-col items-center justify-center px-4 text-center"
    >
      {/* ごまちゃんの画像 */}
      <div class="mb-6">
        <Image
          src={gomaImg}
          class="border-skin-card h-32 w-32 rounded-full border-4 object-cover shadow-lg"
          alt="守り神のごま"
        />
      </div>

      <h1 class="text-skin-accent text-8xl font-bold tracking-tighter">404</h1>

      <p class="text-skin-base mt-4 text-2xl font-bold sm:text-3xl">
        System Error... or Bug?
      </p>

      <p class="text-skin-base mt-4 text-lg leading-relaxed opacity-90">
        お探しのページは見つかりませんでした。<br />
        System Fixerもまだこのリンクは直せていないようです。<br />
        （ごまに願いをかけてみてください)
      </p>

      <LinkButton
        href="/"
        class="border-skin-line hover:bg-skin-card mt-8 rounded-full border px-6 py-3 text-lg transition-colors"
      >
        トップページに戻る (Fix)
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
